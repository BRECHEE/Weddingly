generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANIZER
  PHOTOGRAPHER
  GUEST
}

enum RSVPStatus {
  ATTENDING
  DECLINED
  UNKNOWN
}

enum InvitationTemplate {
  CLASSIC
  MODERN
  ROMANTIC
}

enum ActivityType {
  INVITATION_VIEWED
  RSVP_UPDATED
  PHOTO_UPLOADED
  PHOTO_DELETED
  PHOTO_DOWNLOADED
  ALBUM_CREATED
  GUEST_CREATED
  GUEST_UPDATED
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  passwordHash  String?
  role          Role           @default(ORGANIZER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  weddings      WeddingMember[]
  photographerAssignments WeddingPhotographer[]
  guestBookMessages GuestBookMessage[]
  activityLogs  ActivityLog[]
}

model Wedding {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  description   String?
  date          DateTime?
  locationName  String?
  locationAddress String?
  coverImage    String?
  status        String          @default("draft")
  invitationTemplate InvitationTemplate @default(CLASSIC)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  members       WeddingMember[]
  guests        Guest[]
  groups        GuestGroup[]
  invitations  Invitation[]
  albums        Album[]
  photos        Photo[]
  rsvps         RSVP[]
  scheduleItems ScheduleItem[]
  activityLogs  ActivityLog[]
  guestBookMessages GuestBookMessage[]
  photographers WeddingPhotographer[]
}

model WeddingMember {
  id         String   @id @default(cuid())
  userId     String
  weddingId  String
  role       Role     @default(ORGANIZER)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wedding    Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@unique([userId, weddingId])
  @@index([weddingId])
  @@index([userId])
}

model Guest {
  id              String             @id @default(cuid())
  weddingId       String
  firstName       String
  lastName        String
  phone           String?
  email           String?
  invitationCode  String            @unique
  photoPass       String            @unique
  status          RSVPStatus        @default(UNKNOWN)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  wedding         Wedding            @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  invitation      Invitation?
  rsvp            RSVP?
  guestGroups     GuestGroupMember[]
  photoAssociations PhotoGuest[]
  favoritePhotos Favorite[]
  guestBookMessages GuestBookMessage[]

  @@index([weddingId])
  @@index([invitationCode])
  @@index([photoPass])
  @@index([createdAt])
}

model GuestGroup {
  id          String             @id @default(cuid())
  weddingId   String
  name        String
  description String?
  createdAt   DateTime           @default(now())

  wedding     Wedding            @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  members     GuestGroupMember[]
  photoGroups PhotoGroup[]

  @@index([weddingId])
  @@index([name])
}

model GuestGroupMember {
  id        String      @id @default(cuid())
  guestId   String
  groupId   String
  createdAt DateTime    @default(now())

  guest     Guest       @relation(fields: [guestId], references: [id], onDelete: Cascade)
  group     GuestGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([guestId, groupId])
  @@index([guestId])
  @@index([groupId])
}

model Invitation {
  id             String   @id @default(cuid())
  guestId        String   @unique
  weddingId      String
  template       InvitationTemplate @default(CLASSIC)
  qrCodeUrl      String?
  url            String
  viewedAt       DateTime?
  createdAt      DateTime @default(now())

  guest          Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  wedding        Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
  @@index([guestId])
}

model Album {
  id          String   @id @default(cuid())
  weddingId   String
  name        String
  description String?
  coverPhoto  String?
  visibility  String   @default("private")
  createdAt   DateTime @default(now())

  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  photos      Photo[]

  @@index([weddingId])
  @@index([createdAt])
}

model Photo {
  id              String         @id @default(cuid())
  weddingId       String
  albumId         String?
  uploaderId      String?
  fileName        String
  originalUrl     String
  thumbnailUrl    String?
  mediumUrl       String?
  optimizedUrl    String?
  size            Int?
  width           Int?
  height          Int?
  mimeType        String
  public          Boolean        @default(false)
  isPublished     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  wedding         Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  album           Album?         @relation(fields: [albumId], references: [id], onDelete: SetNull)
  guestRelations  PhotoGuest[]
  groupRelations  PhotoGroup[]
  tags            PhotoTag[]
  favorites       Favorite[]

  @@index([weddingId])
  @@index([albumId])
  @@index([createdAt])
  @@index([public])
}

model PhotoGuest {
  id        String   @id @default(cuid())
  photoId   String
  guestId   String
  createdAt DateTime @default(now())

  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([photoId, guestId])
  @@index([photoId])
  @@index([guestId])
}

model PhotoGroup {
  id        String   @id @default(cuid())
  photoId   String
  groupId   String
  createdAt DateTime @default(now())

  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  group     GuestGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([photoId, groupId])
  @@index([photoId])
  @@index([groupId])
}

model Tag {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  photoTags PhotoTag[]
}

model PhotoTag {
  id        String   @id @default(cuid())
  photoId   String
  tagId     String
  createdAt DateTime @default(now())

  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([photoId, tagId])
  @@index([photoId])
  @@index([tagId])
}

model RSVP {
  id         String     @id @default(cuid())
  guestId    String     @unique
  weddingId  String
  status     RSVPStatus @default(UNKNOWN)
  note       String?
  updatedAt  DateTime   @updatedAt

  guest      Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  wedding    Wedding    @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
  @@index([status])
}

model Favorite {
  id         String   @id @default(cuid())
  guestId    String
  photoId    String
  createdAt  DateTime @default(now())

  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  photo      Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([guestId, photoId])
  @@index([guestId])
  @@index([photoId])
}

model GuestBookMessage {
  id          String   @id @default(cuid())
  weddingId   String
  guestId     String?
  authorName  String
  content     String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guest       Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  user        User?    @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([weddingId])
  @@index([createdAt])
}

model ScheduleItem {
  id         String   @id @default(cuid())
  weddingId  String
  time       String
  title      String
  details    String?
  createdAt  DateTime @default(now())

  wedding    Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
  @@index([time])
}

model WeddingPhotographer {
  id            String   @id @default(cuid())
  weddingId     String
  photographerId String
  permissions   String[] @default([])
  createdAt     DateTime @default(now())

  wedding       Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  photographer  User     @relation(fields: [photographerId], references: [id], onDelete: Cascade)

  @@unique([weddingId, photographerId])
  @@index([weddingId])
  @@index([photographerId])
}

model ActivityLog {
  id          String       @id @default(cuid())
  weddingId   String
  userId      String?
  action      ActivityType
  metadata    Json?
  createdAt   DateTime     @default(now())

  wedding     Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([weddingId])
  @@index([action])
  @@index([createdAt])
}
